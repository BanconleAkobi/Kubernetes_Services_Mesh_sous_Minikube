server {
    listen 80;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # config.js regénéré au démarrage du conteneur : pas de mise en cache.
    location = /config.js {
        add_header Cache-Control "no-store, no-cache";
    }

    # Proxy vers service1 — enregistrement d'un échantillon (port 9000).
    location /api/register {
        proxy_pass         ${SERVICE1_URL}/api/register;
        proxy_set_header   Host            $host;
        proxy_set_header   X-Real-IP       $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Proxy vers service3 — lecture du résultat validé (port 9002).
    # /api/results/{id} → service3:/api/validate/validated/{id}
    location /api/results {
        proxy_pass         ${SERVICE3_URL}/api/validate/validated;
        proxy_set_header   Host            $host;
        proxy_set_header   X-Real-IP       $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
