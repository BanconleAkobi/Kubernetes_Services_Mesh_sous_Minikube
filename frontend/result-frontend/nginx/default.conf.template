server {
    listen 80;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # config.js regénéré au démarrage du conteneur : pas de mise en cache.
    location = /config.js {
        add_header Cache-Control "no-store, no-cache";
    }

    # Proxy vers sample-api (port 9000 dans le cluster Kubernetes).
    location /api/samples {
        proxy_pass         ${SAMPLE_API_URL}/samples;
        proxy_set_header   Host            $host;
        proxy_set_header   X-Real-IP       $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Proxy vers analysis-api (port 9001 dans le cluster Kubernetes).
    location /api/analyze {
        proxy_pass         ${ANALYSIS_API_URL}/analyze;
        proxy_set_header   Host            $host;
        proxy_set_header   X-Real-IP       $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
